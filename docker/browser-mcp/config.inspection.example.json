{
  "listen": "0.0.0.0:8080",
  "node": "node",
  "worker": "/app/browser/container-worker.mjs",
  "allowAllWeb": false,
  "allowedOrigins": ["https://shop.example", "https://store.example"],
  "inspectionOnly": true,
  "keys": {"CertURL": "https://issuer.example/.well-known/jwks.json"},
  "identityPolicy": {
    "issuer": "https://issuer.example",
    "algorithms": ["RS256"],
    "requiredScopes": ["browser:use"]
  },
  "operationTimeoutSeconds": 60,
  "networkRules": [
    {
      "origin": "https://metrics.example",
      "path": "/collect",
      "parameters": {"pixel": "value", "amount": "value", "currency": "value", "order": "presence"}
    }
  ]
}
