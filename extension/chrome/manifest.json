{
  "manifest_version": 3,
  "name": "Mechanize",
  "version": "0.1.72",
  "description": "Explicitly enrolled semantic browser transport for Mechanize.",
  "permissions": [
    "nativeMessaging",
    "alarms",
    "storage",
    "scripting",
    "webNavigation",
    "debugger"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Mechanize browser automation (0.1.72)"
  },
  "minimum_chrome_version": "106",
  "incognito": "not_allowed",
  "externally_connectable": {
    "matches": [
      "https://*/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
