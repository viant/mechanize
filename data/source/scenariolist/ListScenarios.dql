#package('github.com/viant/mechanize/data/scenariolist')
#setting($_ = $input_type('ListScenariosInput'))
#setting($_ = $output_type('ListScenariosOutput'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/internal/data/scenariolist', 'GET'))
#setting($_ = $connector('user'))
#define($_ = $Namespace<string>(query/namespace).Required())
#define($_ = $ScenarioID<string>(query/scenarioId).Required())
#define($_ = $Revision<string>(query/revision).Required())
#define($_ = $Limit<int>(query/limit).Required())
#define($_ = $ObjectiveHash<string>(query/objectiveHash).Required())
#define($_ = $AfterID<string>(query/afterId).Required())
#define($_ = $AfterRevision<string>(query/afterRevision).Required())
#define($_ = $Data<[]*ScenarioRevision>(output/view))
SELECT records.*,type(records,'ScenarioRevision')
FROM (${embed:sql/root.sql}) records
