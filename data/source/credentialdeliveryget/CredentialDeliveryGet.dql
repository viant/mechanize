#package('github.com/viant/mechanize/data/credentialdeliveryget')
#setting($_ = $input_type('CredentialDeliveryGetInput'))
#setting($_ = $output_type('CredentialDeliveryGetOutput'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/internal/data/credentialdeliveryget', 'GET'))
#setting($_ = $connector('user'))
#define($_ = $Namespace<string>(query/namespace).Required())
#define($_ = $ClientID<string>(query/clientId).Required())
#define($_ = $AttemptID<string>(query/attemptId).Required())
#define($_ = $Data<[]*Delivery>(output/view))
SELECT deliveries.*,audit.*,type(deliveries,'Delivery'),type(audit,'Audit')
FROM (${embed:sql/root.sql}) deliveries
JOIN (SELECT a.* FROM credential_delivery_audit a) audit ON audit.namespace=deliveries.namespace AND audit.client_id=deliveries.client_id AND audit.attempt_id=deliveries.attempt_id
