#package('github.com/viant/mechanize/data/scenariopublish')
#setting($_ = $input_type('PublishScenarioDraftInput'))
#setting($_ = $output_type('PublishScenarioDraftOutput'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/internal/data/scenariopublish', 'POST'))
#setting($_ = $connector('user'))
#define($_ = $Namespace<string>(query/namespace).Required())
#define($_ = $Data<[]*ScenarioRevision>(output/body))
SELECT records.*,type(records,'ScenarioRevision'),lifecycle_type(records,'ScenarioRevisionLifecycle')
FROM (${embed:sql/root.sql}) records
