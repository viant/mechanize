#package('github.com/viant/mechanize/data/credentialrecoveryload')
#setting($_ = $input_type('CredentialRecoveryLoadInput'))
#setting($_ = $output_type('CredentialRecoveryLoadOutput'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/internal/data/credentialrecoveryload', 'GET'))
#setting($_ = $connector('user'))
#define($_ = $Namespace<string>(query/namespace).Required())
#define($_ = $ClientID<string>(query/clientId).Required())
#define($_ = $PreparationID<string>(query/preparationId).Required())
#define($_ = $Data<[]*Preparation>(output/view))
SELECT preparations.*,deliveries.*,type(preparations,'Preparation'),type(deliveries,'Delivery')
FROM (${embed:sql/root.sql}) preparations
JOIN (SELECT a.* FROM credential_delivery_attempts a) deliveries ON deliveries.namespace=preparations.namespace AND deliveries.client_id=preparations.client_id AND deliveries.selection_id=preparations.preparation_id
