#package('github.com/viant/mechanize/data/credentialpreparationreserve')
#setting($_ = $input_type('CredentialPreparationReserveInput'))
#setting($_ = $output_type('CredentialPreparationReserveOutput'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/internal/data/credentialpreparationreserve', 'POST'))
#setting($_ = $connector('user'))
#define($_ = $Namespace<string>(query/namespace).Required())
#define($_ = $ClientID<string>(query/clientId).Required())
#define($_ = $PreparationID<string>(query/preparationId).Required())
#define($_ = $Data<[]*Preparation>(output/body))
SELECT preparations.*,type(preparations,'Preparation'),lifecycle_type(preparations,'PreparationLifecycle')
FROM (${embed:sql/root.sql}) preparations
