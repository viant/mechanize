#package('github.com/viant/mechanize/data/credentialpreparationfinish')
#setting($_ = $input_type('CredentialPreparationFinishInput'))
#setting($_ = $output_type('CredentialPreparationFinishOutput'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/internal/data/credentialpreparationfinish', 'PATCH'))
#setting($_ = $connector('user'))
#define($_ = $Namespace<string>(query/namespace).Required())
#define($_ = $ClientID<string>(query/clientId).Required())
#define($_ = $PreparationID<string>(query/preparationId).Required())
#define($_ = $Data<[]*Preparation>(output/body))
SELECT preparations.*,type(preparations,'Preparation'),lifecycle_type(preparations,'PreparationLifecycle'),concurrency_token(preparations.revision)
FROM (${embed:sql/root.sql}) preparations
