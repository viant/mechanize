#package('github.com/viant/mechanize/data/publishplan')
#setting($_ = $input_type('PublishPlanRevisionInput'))
#setting($_ = $output_type('PublishPlanRevisionOutput'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/internal/data/publishplan', 'POST'))
#setting($_ = $connector('user'))
#define($_ = $Namespace<string>(query/namespace).Required())
#define($_ = $Data<[]*PlanRevision>(output/body))
SELECT records.*, type(records,'PlanRevision'), lifecycle_type(records,'PlanRevisionLifecycle')
FROM (${embed:sql/root.sql}) records
