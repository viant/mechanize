#package('github.com/viant/mechanize/data/loadplan')
#setting($_ = $input_type('LoadPlanInput'))
#setting($_ = $output_type('LoadPlanOutput'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/internal/data/loadplan', 'GET'))
#setting($_ = $connector('user'))
#define($_ = $Namespace<string>(query/namespace).Required())
#define($_ = $PlanID<string>(query/planId).Required())
#define($_ = $Data<[]*PlanRevision>(output/view))
SELECT records.*,type(records,'PlanRevision')
FROM (${embed:sql/root.sql}) records
