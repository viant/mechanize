#package('github.com/viant/mechanize/data/createrun')
#setting($_ = $input_type('CreateRunInput'))
#setting($_ = $output_type('CreateRunOutput'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/internal/data/createrun', 'POST'))
#setting($_ = $connector('user'))
#define($_ = $Namespace<string>(query/namespace).Required())
#define($_ = $Data<[]*Run>(output/body))
SELECT records.*, type(records,'Run'), lifecycle_type(records,'RunLifecycle')
FROM (${embed:sql/root.sql}) records
