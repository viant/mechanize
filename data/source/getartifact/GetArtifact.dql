#package('github.com/viant/mechanize/data/getartifact')
#setting($_ = $input_type('GetArtifactInput'))
#setting($_ = $output_type('GetArtifactOutput'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/internal/data/getartifact', 'GET'))
#setting($_ = $connector('user'))
#define($_ = $Namespace<string>(query/namespace).Required())
#define($_ = $ArtifactID<string>(query/artifactId).Required())
#define($_ = $Data<[]*Artifact>(output/view))
SELECT records.*,type(records,'Artifact')
FROM (${embed:sql/root.sql}) records
