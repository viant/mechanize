#package('github.com/viant/mechanize/data/leasecleanupevidence')
#setting($_ = $input_type('LeaseCleanupEvidenceInput'))
#setting($_ = $output_type('LeaseCleanupEvidenceOutput'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/internal/data/leasecleanupevidence', 'GET'))
#setting($_ = $connector('user'))
#define($_ = $Namespace<string>(query/namespace).Required())
#define($_ = $LeaseEpoch<int>(query/leaseEpoch).Required())
