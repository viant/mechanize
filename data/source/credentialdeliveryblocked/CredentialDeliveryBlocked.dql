#package('github.com/viant/mechanize/data/credentialdeliveryblocked')
#setting($_ = $input_type('CredentialDeliveryBlockedInput'))
#setting($_ = $output_type('CredentialDeliveryBlockedOutput'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/internal/data/credentialdeliveryblocked', 'GET'))
#setting($_ = $connector('user'))
#define($_ = $Namespace<string>(query/namespace).Required())
#define($_ = $Data<[]*Barrier>(output/view))
SELECT status.*,type(status,'Barrier'),CAST(status.blocked AS int) FROM (${embed:sql/root.sql}) status
