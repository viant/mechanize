#package('github.com/viant/mechanize/data/commitoutcome')
#setting($_ = $input_type('CommitOutcomeInput'))
#setting($_ = $output_type('CommitOutcomeOutput'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/internal/data/commitoutcome', 'PATCH'))
#setting($_ = $connector('user'))
#define($_ = $Namespace<string>(query/namespace).Required())
#define($_ = $Data<[]*Effect>(output/body))
SELECT records.*, milestones.*, events.*, type(milestones,'Milestone'), type(events,'Event'), type(records,'Effect'), lifecycle_type(records,'EffectLifecycle'), concurrency_token(records.revision)
FROM (${embed:sql/root.sql}) records
JOIN (SELECT m.* FROM milestones m WHERE m.namespace = :Namespace) milestones ON milestones.namespace = records.namespace AND milestones.attempt_id = records.attempt_id
JOIN (SELECT e.* FROM events e WHERE e.namespace = :Namespace) events ON events.namespace = records.namespace AND events.attempt_id = records.attempt_id
