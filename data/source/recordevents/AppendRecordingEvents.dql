#package('github.com/viant/mechanize/data/recordevents')
#setting($_ = $input_type('AppendRecordingEventsInput'))
#setting($_ = $output_type('AppendRecordingEventsOutput'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/internal/data/recordevents', 'POST'))
#setting($_ = $connector('user'))
#define($_ = $Namespace<string>(query/namespace).Required())
#define($_ = $Data<[]*RecordedEvent>(output/body))
