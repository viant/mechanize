#package('github.com/viant/mechanize/data/listruns')
#setting($_ = $input_type('ListRunsInput'))
#setting($_ = $output_type('ListRunsOutput'))
#setting($_ = $case_format('lc'))
#setting($_ = $route('/internal/data/listruns', 'GET'))
#setting($_ = $connector('user'))
#define($_ = $Namespace<string>(query/namespace).Required())
